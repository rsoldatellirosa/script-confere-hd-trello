# ============================================================
# Hapolo Disk Monitor — Configuracoes
# Copie este arquivo para ".env" e preencha com os valores reais
# NUNCA suba o arquivo .env para o GitHub
# ============================================================

# SSH
SSH_PORT=46824
SSH_USER=root
SSH_TIMEOUT=10

# Percentual de uso que aciona alerta no terminal
ALERT_THRESHOLD=70

# Trello
TRELLO_API_KEY=sua_api_key_aqui
TRELLO_TOKEN=seu_token_aqui
TRELLO_CARD_ID=id_do_card_aqui
CHECKLIST_1_ID=id_da_listinha_I_aqui
CHECKLIST_2_ID=id_da_listinha_II_aqui
